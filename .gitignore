# Data — raw and interim are never committed (re-downloadable, large).
# master.csv is generated by src/merge.py — regenerate, don't commit.
data/master.csv
data/stroke_burden.db
# An empty copy was once committed at the repo root by accident (181df7e);
# the DB must only ever be generated at data/stroke_burden.db.
/stroke_burden.db

# Processed and outputs ARE committable when small, so they are NOT ignored here.
data/raw/
data/interim/

# Large data formats anywhere in the tree
*.parquet
*.zip
*.gz
*.7z
*.tar
*.shp
*.dbf
*.shx

# Secrets — never commit
.env
.env.*
*.env
*.key
*.pem
secrets/
credentials.json
token.json

